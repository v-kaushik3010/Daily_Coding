package Infi;
import java.util.*;

public class Dragons_230A {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
		int s = sc.nextInt();
		int n = sc.nextInt();
		int x[][] = new int[n][2];
		
		for(int i=0;i<n;i++) {
			x[i][0] = sc.nextInt();
			x[i][1] = sc.nextInt();
		}
		
		Arrays.sort(x, (a,b)-> a[0] - b[0]);
		
		boolean flag = true;
		for(int i=0;i<n;i++) {
			if(s > x[i][0]) {
				s += x[i][1];
			}else {
				flag = false;
				break;
			}
		}
		System.out.println(flag ? "YES" : "NO");
		sc.close();
	}

}
